{
  "openapi": "3.0.3",
  "info": {
    "title": "PeekMoment 第一周接口",
    "version": "1.0.0",
    "description": "普通用户的联调发布凭证与管理员会话分别使用。分页从 1 开始。Mock 和 Spring 服务分别运行，数据独立。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Spring Boot 开发服务"
    },
    {
      "url": "http://127.0.0.1:3100",
      "description": "独立联调 Mock，仅供本地开发"
    }
  ],
