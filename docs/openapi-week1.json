  "components": {
    "securitySchemes": {
      "DemoPublisher": {
        "type": "http",
        "scheme": "bearer",
        "description": "开发者配置的演示用户令牌；仅在显式启用演示身份的环境生效。"
      },
      "AdminSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "登录接口返回的管理员令牌。"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 1
        },
        "description": "页码，从 1 开始"
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "description": "每页条数"
      },
      "Keyword": {
        "name": "keyword",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "可选，忽略大小写的字面子串，不解释 SQL 通配符。"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Media": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "src": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "HTTP(S) 媒体地址，或 /uploads/ 下的文件路径。客户端临时路径须先上传。"
          }
        },
        "required": [
          "kind",
          "src"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "maxLength": 1000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            },
            "maxItems": 5
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            },
            "maxItems": 9
          }
        },
        "additionalProperties": false,
        "description": "标题、正文去除首尾空白后与附件至少有一项有内容。标签去空白并按首次出现顺序去重。附件最多九张图片或单个视频。长度按客户端 UTF-16 计数。"
      },
      "Moment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "description": "Unix 毫秒时间戳"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "pending",
              "hidden"
            ]
          },
          "ratings": {
            "type": "object",
            "description": "第一周占位，返回空对象。"
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "第一周占位，返回空数组。"
          }
        },
        "required": [
          "id",
          "userId",
          "author",
          "title",
          "body",
          "tags",
          "media",
          "createdAt",
          "status",
          "ratings",
          "comments"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "description": "Unix 毫秒时间戳"
          }
        },
        "required": [
          "id",
          "nickname",
          "createdAt"
        ]
      },
      "MomentPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Moment"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
